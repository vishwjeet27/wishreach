# Copy this file to ".env" for local development. The .env file is never packaged.

# Optional. Used only when no key has been saved inside the app (Settings > Groq).
GROQ_API_KEY=

# Optional. Override the Groq OpenAI-compatible endpoint.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Optional. Request timeout in milliseconds.
GROQ_TIMEOUT_MS=60000
